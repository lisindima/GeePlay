<resources>
    <string name="settings_geely_navigation_title">吉利原车导航（实验性）</string>
    <string name="settings_geely_navigation_description">将 CarPlay 转向信息发送到原车 ECARX 导航接口。检测到接口不代表仪表一定能够显示；连接方式修改将在下次连接时生效。</string>
    <string name="settings_geely_navigation_enable">在原车仪表显示 CarPlay 导航</string>
    <string name="settings_geely_navigation_enable_description">可能接管仪表导航画面，修改将在下次连接 CarPlay 时生效。</string>
    <string name="settings_geely_navigation_confirm_title">启用实验性原车导航？</string>
    <string name="settings_geely_navigation_confirm_message">这可能覆盖车辆自己的导航提示。请停车后测试，并确认断开连接后导航内容能够清除。</string>
    <string name="settings_geely_navigation_confirm_action">启用</string>
    <string name="settings_geely_navigation_backend">平台连接方式</string>
    <string name="settings_geely_backend_auto">自动探测</string>
    <string name="settings_geely_backend_ecarx_flyme">ECARX / Flyme Auto</string>
    <string name="settings_geely_backend_oneos">OneOS 兼容模式</string>
    <string name="settings_geely_lane_guidance">车道提示（实验性）</string>
    <string name="settings_geely_lane_guidance_description">为 ECARX 车道接口绘制 CarPlay 车道方向，需要兼容的仪表；修改将在下次连接时生效。</string>
    <string name="settings_geely_lane_number_base">车道编号</string>
    <string name="settings_geely_lane_number_zero">从 0 开始</string>
    <string name="settings_geely_lane_number_one">从 1 开始</string>
    <string name="settings_geely_semantic_junction">简化路口几何（实验性）</string>
    <string name="settings_geely_semantic_junction_description">只绘制 RouteGuidance 的语义支路，不是原厂路口大图；修改将在下次连接时生效。</string>
    <string name="settings_geely_oneos_original_icons">使用 OneOS 原始转向编号（实验性）</string>
    <string name="settings_geely_oneos_original_icons_description">不做 ECARX 映射，直接传递 Apple 转向编号。仅在目标固件需要时启用。</string>
    <string name="settings_geely_audio_title">吉利音频控制方</string>
    <string name="settings_geely_audio_description">选择音乐的播放方。原车蓝牙模式由车辆播放音乐并处理媒体键，GeePlay 仍播放导航、Siri 和通话音频；修改将在下次连接时生效。</string>
    <string name="settings_geely_media_owner">音乐输出</string>
    <string name="settings_geely_media_owner_bluetooth">原车蓝牙</string>
    <string name="settings_geely_media_owner_diplay">CarPlay</string>
    <string name="settings_geely_bluetooth_media_auto_avoid">CarPlay 启动时自动禁用车机蓝牙媒体（实验性）</string>
    <string name="settings_geely_bluetooth_media_auto_avoid_description">CarPlay 启动后仅断开车机 A2DP 媒体，避免播放/暂停抢占；不会关闭蓝牙，通话和配对保持连接；下次连接生效。</string>
    <string name="settings_geely_bluetooth_media_auto_restore">CarPlay 结束时自动恢复车机蓝牙媒体（实验性）</string>
    <string name="settings_geely_bluetooth_media_auto_restore_description">CarPlay 结束后请求 G636 系统蓝牙音乐应用重新连接 A2DP 并切回原车蓝牙音源，音乐可能继续播放。若媒体仍关闭，请使用下方恢复按钮。关闭此项可让非 CarPlay 状态始终不播放车载蓝牙音乐。</string>
    <string name="settings_geely_bluetooth_media_open_settings">打开原车蓝牙恢复媒体</string>
    <string name="settings_geely_bluetooth_media_confirm_title">使用 CarPlay 播放音乐？</string>
    <string name="settings_geely_bluetooth_media_confirm_message">GeePlay 将在 CarPlay 运行期间自动断开车机蓝牙媒体，不会关闭蓝牙或断开通话。自动恢复是独立设置，默认关闭；需要“附近设备”权限。</string>
    <string name="settings_geely_bluetooth_media_confirm_action">使用 CarPlay 并开启避让</string>
    <string name="settings_geely_input_title">吉利方向盘输入（实验性）</string>
    <string name="settings_geely_input_description">OneOS 媒体键和 Flyme 语音广播只在 CarPlay 会话活动时生效；原车蓝牙模式不截获媒体键；输入方式修改立即生效。</string>
    <string name="settings_geely_input_profile">输入平台</string>
    <string name="settings_geely_input_disabled">关闭</string>
    <string name="settings_geely_input_oneos">OneOS 媒体键</string>
    <string name="settings_geely_input_flyme">Flyme 语音键</string>
    <string name="settings_geely_flyme_confirm_title">启用 Flyme 语音广播？</string>
    <string name="settings_geely_flyme_confirm_message">该原车广播没有已验证的发送者权限，本机其他应用可能伪造事件，原车语音助手也可能同时响应。</string>
    <string name="settings_geely_flyme_confirm_action">仍然启用</string>
    <string name="settings_geely_input_xui_diagnostic">仅检测 ECARX XUI</string>
    <string name="settings_geely_input_oneos2_diagnostic">仅检测 OneOS 2</string>
    <string name="settings_geely_cluster_display_title">吉利仪表画面（实验性）</string>
    <string name="settings_geely_cluster_display_enable">将 stream 111 投射到已验证的仪表屏</string>
    <string name="settings_geely_cluster_display_description">仅对经过实车验证且与当前固件、显示屏精确匹配的 profile 开放；修改将在下次连接时生效。</string>
    <string name="settings_geely_cluster_display_unavailable">当前固件没有匹配的实车验证显示 profile。直投保持关闭；请导出诊断以记录显示屏清单。</string>
    <string name="settings_geely_cluster_debug_description">仅用于调试。可临时选择非默认 Android Presentation 显示屏并绕过实车验证 profile；下次连接 CarPlay 时生效。</string>
    <string name="settings_geely_cluster_debug_no_displays">当前没有可用的非默认 Android Presentation 显示屏。目标屏出现后请重新打开设置。</string>
    <string name="settings_geely_cluster_debug_target">调试目标显示屏</string>
    <string name="settings_geely_cluster_debug_disabled">关闭</string>
    <string name="settings_geely_cluster_debug_confirm_title">投射到这个显示屏？</string>
    <string name="settings_geely_cluster_debug_confirm_message">这会绕过实车验证显示 profile，并可能覆盖原车仪表内容。仅在停车时使用；下次连接 CarPlay 时生效。</string>
    <string name="settings_geely_cluster_debug_confirm_action">使用此显示屏</string>
    <string name="settings_geely_diagnostics_title">吉利集成诊断</string>
    <string name="settings_geely_refresh">刷新吉利接口并重试清理</string>
    <string name="settings_geely_diagnostics_status">导航 SDK：%1$s\nDriver：%2$s\n最近失败：%3$s</string>
    <string name="settings_geely_available">可用</string>
    <string name="settings_geely_unavailable">未检测到</string>
    <string name="settings_geely_upstream_compatibility_title">上游兼容性</string>
    <string name="settings_geely_block_byd_menus">屏蔽 BYD 专属设置</string>
    <string name="settings_geely_block_byd_menus_description">隐藏上游 DiPlay 中仅适用于 BYD 或 DiLink 的设置。GeePlay 建议保持开启；修改立即生效，不会关闭通用 CarPlay 功能。</string>
    <string name="settings_geely_evcc_title">EVCC 车辆数据（实验性）</string>
    <string name="settings_geely_evcc_description">从 EVCC 1.2 读取已授权的车辆数据，并向已连接的 iPhone 发送支持的电量、续航、车速和挡位信息；修改将在下次连接时生效。</string>
    <string name="settings_geely_evcc_vehicle_status">向 CarPlay 发送电量和续航</string>
    <string name="settings_geely_evcc_vehicle_status_description">EVCC 提供可信数据时，将动力电池电量、剩余续航和充电状态发送给已连接的 iPhone；下次连接生效。</string>
    <string name="settings_geely_evcc_vehicle_speed">向 CarPlay 定位发送车速</string>
    <string name="settings_geely_evcc_vehicle_speed_description">在 iPhone 请求的位置数据中加入 EVCC 轮速和挡位；还需要启用位置共享；下次连接生效。</string>
    <string name="settings_geely_evcc_wheel_speed_sampling">轮速采样频率（实验性）</string>
    <string name="settings_geely_evcc_wheel_speed_sampling_description">控制 GeePlay 在每个 $PASCD 数据包中采样 EVCC 内存车速缓存的频率；不会强制读取车辆总线。更高频率将在下次连接时生效，并占用更多 CPU。</string>
    <string name="settings_geely_evcc_wheel_speed_sampling_standard">4 Hz · 250 ms（默认）</string>
    <string name="settings_geely_evcc_wheel_speed_sampling_fast">10 Hz · 100 ms</string>
    <string name="settings_geely_evcc_video_while_parked">仅驻车时允许车内视频（实验性）</string>
    <string name="settings_geely_evcc_video_while_parked_description">使用已验证的 EVCC 挡位；数据缺失或过期时禁止播放；下次连接生效。</string>
    <string name="settings_geely_evcc_video_confirm_title">启用驻车视频？</string>
    <string name="settings_geely_evcc_video_confirm_message">仅 EVCC 报告 P 挡时提供视频；车辆数据未知、过期或断开时会禁止播放。请仅在法律允许时使用。</string>
    <string name="settings_geely_evcc_tyre_telemetry">显示 EVCC 胎压和胎温（实验性）</string>
    <string name="settings_geely_evcc_tyre_telemetry_description">发现当前固件的只读轮胎属性，并在侧边栏显示四轮新鲜数据；下次连接生效。</string>
    <string name="settings_geely_evcc_tyre_confirm_message">GeePlay 将检查 EVCC 只读属性目录中的胎压和胎温；不支持或轮位不明确的数据会保持隐藏。</string>
    <string name="settings_geely_evcc_low_charge_percent">低电量提醒阈值</string>
    <string name="settings_geely_evcc_charging_connectors">充电接口</string>
    <string name="settings_geely_evcc_confirm_title">启用 EVCC 车辆数据？</string>
    <string name="settings_geely_evcc_confirm_message">GeePlay 将从 EVCC 读取所选车辆数据，并与已连接的 iPhone 共享；仍需在 EVCC 中授权。</string>
    <string name="settings_geely_evcc_confirm_action">启用</string>
    <string name="settings_geely_evcc_open_settings">打开 EVCC 授权</string>
    <string name="settings_geely_evcc_unavailable">EVCC 车辆数据适配器不可用。</string>
    <string name="settings_geely_evcc_system_actions_title">EVCC 系统操作（实验性）</string>
    <string name="settings_geely_evcc_system_actions_description">仅限用户主动触发的一次性操作；每次写入都需要 EVCC Shell 授权和车机端单独确认，GeePlay 不会自动执行。</string>
    <string name="settings_geely_evcc_grant_hotspot">通过 EVCC 允许热点系统设置</string>
    <string name="settings_geely_evcc_grant_overlay">通过 EVCC 允许悬浮窗启动</string>
    <string name="settings_geely_evcc_allow_background">通过 EVCC 允许后台运行</string>
    <string name="settings_geely_evcc_allow_doze">通过 EVCC 加入休眠白名单</string>
    <string name="settings_geely_evcc_system_confirm_title">将此系统操作发送给 EVCC？</string>
    <string name="settings_geely_evcc_system_confirm_message">需要在 EVCC 授权 shell.exec 和 shell.system_write，并在车机屏幕再次确认；操作失败后不会自动重试。</string>
    <string name="settings_geely_evcc_system_confirm_action">继续到 EVCC</string>
    <string name="settings_geely_evcc_ambient_title">EVCC 氛围灯（实验性）</string>
    <string name="settings_geely_evcc_ambient_enable">让车内灯光跟随 CarPlay 音乐</string>
    <string name="settings_geely_evcc_ambient_description">仅使用通过实车验证的 EVCC 可写属性 Profile，并执行校验、回读和恢复。</string>
    <string name="settings_geely_evcc_ambient_unavailable">当前固件没有通过实车验证的可写氛围灯 Profile，写入保持禁用。</string>
    <string name="settings_geely_evcc_ambient_confirm_title">通过 EVCC 控制氛围灯？</string>
    <string name="settings_geely_evcc_ambient_confirm_message">GeePlay 将保存当前灯光，校验每次写入、回读结果，并在播放结束时恢复原状态；需要 EVCC property.write 授权。</string>
</resources>
