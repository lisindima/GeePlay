<resources>
    <string name="settings_geely_navigation_title">吉利原車導航（實驗性）</string>
    <string name="settings_geely_navigation_description">將 CarPlay 轉向資訊傳送到原車 ECARX 導航介面。偵測到介面不代表儀表一定能夠顯示；連線方式修改將在下次連線時生效。</string>
    <string name="settings_geely_navigation_enable">在原車儀表顯示 CarPlay 導航</string>
    <string name="settings_geely_navigation_enable_description">可能接管儀表導航畫面，修改將在下次連接 CarPlay 時生效。</string>
    <string name="settings_geely_navigation_confirm_title">啟用實驗性原車導航？</string>
    <string name="settings_geely_navigation_confirm_message">這可能覆蓋車輛自己的導航提示。請停車後測試，並確認斷開連線後導航內容能夠清除。</string>
    <string name="settings_geely_navigation_confirm_action">啟用</string>
    <string name="settings_geely_navigation_backend">平台連線方式</string>
    <string name="settings_geely_backend_auto">自動偵測</string>
    <string name="settings_geely_backend_ecarx_flyme">ECARX / Flyme Auto</string>
    <string name="settings_geely_backend_oneos">OneOS 相容模式</string>
    <string name="settings_geely_lane_guidance">車道提示（實驗性）</string>
    <string name="settings_geely_lane_guidance_description">為 ECARX 車道介面繪製 CarPlay 車道方向，需要相容的儀表；修改將在下次連線時生效。</string>
    <string name="settings_geely_lane_number_base">車道編號</string>
    <string name="settings_geely_lane_number_zero">從 0 開始</string>
    <string name="settings_geely_lane_number_one">從 1 開始</string>
    <string name="settings_geely_semantic_junction">簡化路口幾何（實驗性）</string>
    <string name="settings_geely_semantic_junction_description">只繪製 RouteGuidance 的語意支路，不是原廠路口大圖；修改將在下次連線時生效。</string>
    <string name="settings_geely_oneos_original_icons">使用 OneOS 原始轉向編號（實驗性）</string>
    <string name="settings_geely_oneos_original_icons_description">不做 ECARX 映射，直接傳遞 Apple 轉向編號。僅在目標韌體需要時啟用。</string>
    <string name="settings_geely_audio_title">吉利音訊控制方</string>
    <string name="settings_geely_audio_description">選擇音樂播放方。原車藍牙模式由車輛播放音樂並處理媒體鍵，GeePlay 仍播放導航、Siri 和通話音訊；修改將在下次連線時生效。</string>
    <string name="settings_geely_media_owner">音樂輸出</string>
    <string name="settings_geely_media_owner_bluetooth">原車藍牙</string>
    <string name="settings_geely_media_owner_diplay">CarPlay</string>
    <string name="settings_geely_bluetooth_media_auto_avoid">自動避讓車機藍牙媒體（實驗性）</string>
    <string name="settings_geely_bluetooth_media_auto_avoid_description">選擇 CarPlay 播放音樂時，僅暫時中斷車機 A2DP 媒體，避免播放/暫停搶佔；不會關閉藍牙或中斷通話，CarPlay 結束後自動恢復；下次連線生效。</string>
    <string name="settings_geely_bluetooth_media_confirm_title">使用 CarPlay 播放音樂？</string>
    <string name="settings_geely_bluetooth_media_confirm_message">GeePlay 將在 CarPlay 執行期間自動中斷車機藍牙媒體，不會關閉藍牙或中斷通話，並會在 CarPlay 結束後恢復；需要「附近裝置」權限。</string>
    <string name="settings_geely_bluetooth_media_confirm_action">使用 CarPlay 並開啟避讓</string>
    <string name="settings_geely_input_title">吉利方向盤輸入（實驗性）</string>
    <string name="settings_geely_input_description">OneOS 媒體鍵和 Flyme 語音廣播只在 CarPlay 工作階段啟用；原車藍牙模式不攔截媒體鍵；輸入方式修改立即生效。</string>
    <string name="settings_geely_input_profile">輸入平台</string>
    <string name="settings_geely_input_disabled">關閉</string>
    <string name="settings_geely_input_oneos">OneOS 媒體鍵</string>
    <string name="settings_geely_input_flyme">Flyme 語音鍵</string>
    <string name="settings_geely_flyme_confirm_title">啟用 Flyme 語音廣播？</string>
    <string name="settings_geely_flyme_confirm_message">該原車廣播沒有已驗證的傳送者權限，本機其他應用可能偽造事件，原車語音助理也可能同時回應。</string>
    <string name="settings_geely_flyme_confirm_action">仍然啟用</string>
    <string name="settings_geely_input_xui_diagnostic">僅偵測 ECARX XUI</string>
    <string name="settings_geely_input_oneos2_diagnostic">僅偵測 OneOS 2</string>
    <string name="settings_geely_cluster_display_title">吉利儀表畫面（實驗性）</string>
    <string name="settings_geely_cluster_display_enable">將 stream 111 投射到已驗證的儀表螢幕</string>
    <string name="settings_geely_cluster_display_description">只對經實車驗證且與目前韌體、顯示器精確匹配的 profile 開放；修改將在下次連線時生效。</string>
    <string name="settings_geely_cluster_display_unavailable">目前韌體沒有匹配的實車驗證顯示 profile。直投保持關閉；請匯出診斷以記錄顯示器清單。</string>
    <string name="settings_geely_cluster_debug_description">僅供除錯。可暫時選擇非預設 Android Presentation 顯示器並略過實車驗證 profile；下次連線 CarPlay 時生效。</string>
    <string name="settings_geely_cluster_debug_no_displays">目前沒有可用的非預設 Android Presentation 顯示器。目標顯示器出現後請重新開啟設定。</string>
    <string name="settings_geely_cluster_debug_target">除錯目標顯示器</string>
    <string name="settings_geely_cluster_debug_disabled">關閉</string>
    <string name="settings_geely_cluster_debug_confirm_title">投射到這個顯示器？</string>
    <string name="settings_geely_cluster_debug_confirm_message">這會略過實車驗證顯示 profile，並可能覆蓋原車儀表內容。僅在停車時使用；下次連線 CarPlay 時生效。</string>
    <string name="settings_geely_cluster_debug_confirm_action">使用此顯示器</string>
    <string name="settings_geely_diagnostics_title">吉利整合診斷</string>
    <string name="settings_geely_refresh">重新整理吉利介面並重試清理</string>
    <string name="settings_geely_diagnostics_status">導航 SDK：%1$s\nDriver：%2$s\n最近失敗：%3$s</string>
    <string name="settings_geely_available">可用</string>
    <string name="settings_geely_unavailable">未偵測到</string>
    <string name="settings_geely_upstream_compatibility_title">上游相容性</string>
    <string name="settings_geely_block_byd_menus">屏蔽 BYD 專屬設定</string>
    <string name="settings_geely_block_byd_menus_description">隱藏上游 DiPlay 中僅適用於 BYD 或 DiLink 的設定。GeePlay 建議保持開啟；修改立即生效，不會關閉共用 CarPlay 功能。</string>
    <string name="settings_geely_evcc_title">EVCC 車輛資料（實驗性）</string>
    <string name="settings_geely_evcc_description">從 EVCC 1.2 讀取已授權的車輛資料，並向已連線的 iPhone 傳送支援的電量、續航、車速和檔位資訊；修改將在下次連線時生效。</string>
    <string name="settings_geely_evcc_vehicle_status">向 CarPlay 傳送電量和續航</string>
    <string name="settings_geely_evcc_vehicle_status_description">EVCC 提供可信資料時，將動力電池電量、剩餘續航和充電狀態傳送給已連線的 iPhone；下次連線生效。</string>
    <string name="settings_geely_evcc_vehicle_speed">向 CarPlay 定位傳送車速</string>
    <string name="settings_geely_evcc_vehicle_speed_description">在 iPhone 要求的位置資料中加入 EVCC 輪速和檔位；還需要啟用位置共享；下次連線生效。</string>
    <string name="settings_geely_evcc_video_while_parked">僅駐車時允許車內影片（實驗性）</string>
    <string name="settings_geely_evcc_video_while_parked_description">使用已驗證的 EVCC 檔位；資料缺失或過期時禁止播放；下次連線生效。</string>
    <string name="settings_geely_evcc_video_confirm_title">啟用駐車影片？</string>
    <string name="settings_geely_evcc_video_confirm_message">僅 EVCC 回報 P 檔時提供影片；車輛資料未知、過期或中斷時會禁止播放。請僅在法律允許時使用。</string>
    <string name="settings_geely_evcc_tyre_telemetry">顯示 EVCC 胎壓和胎溫（實驗性）</string>
    <string name="settings_geely_evcc_tyre_telemetry_description">發現目前韌體的唯讀輪胎屬性，並在側邊欄顯示四輪新鮮資料；下次連線生效。</string>
    <string name="settings_geely_evcc_tyre_confirm_message">GeePlay 將檢查 EVCC 唯讀屬性目錄中的胎壓和胎溫；不支援或輪位不明確的資料會保持隱藏。</string>
    <string name="settings_geely_evcc_low_charge_percent">低電量提醒門檻</string>
    <string name="settings_geely_evcc_charging_connectors">充電介面</string>
    <string name="settings_geely_evcc_confirm_title">啟用 EVCC 車輛資料？</string>
    <string name="settings_geely_evcc_confirm_message">GeePlay 將從 EVCC 讀取所選車輛資料，並與已連線的 iPhone 分享；仍需在 EVCC 中授權。</string>
    <string name="settings_geely_evcc_confirm_action">啟用</string>
    <string name="settings_geely_evcc_open_settings">開啟 EVCC 授權</string>
    <string name="settings_geely_evcc_unavailable">EVCC 車輛資料 Adapter 無法使用。</string>
    <string name="settings_geely_evcc_system_actions_title">EVCC 系統操作（實驗性）</string>
    <string name="settings_geely_evcc_system_actions_description">僅限使用者主動觸發的一次性操作；每次寫入都需要 EVCC Shell 授權和車機端單獨確認，GeePlay 不會自動執行。</string>
    <string name="settings_geely_evcc_grant_hotspot">透過 EVCC 允許熱點系統設定</string>
    <string name="settings_geely_evcc_grant_overlay">透過 EVCC 允許懸浮視窗啟動</string>
    <string name="settings_geely_evcc_allow_background">透過 EVCC 允許背景執行</string>
    <string name="settings_geely_evcc_allow_doze">透過 EVCC 加入休眠白名單</string>
    <string name="settings_geely_evcc_system_confirm_title">將此系統操作傳送給 EVCC？</string>
    <string name="settings_geely_evcc_system_confirm_message">需要在 EVCC 授權 shell.exec 和 shell.system_write，並在車機螢幕再次確認；操作失敗後不會自動重試。</string>
    <string name="settings_geely_evcc_system_confirm_action">繼續到 EVCC</string>
    <string name="settings_geely_evcc_ambient_title">EVCC 氛圍燈（實驗性）</string>
    <string name="settings_geely_evcc_ambient_enable">讓車內燈光跟隨 CarPlay 音樂</string>
    <string name="settings_geely_evcc_ambient_description">僅使用通過實車驗證的 EVCC 可寫屬性 Profile，並執行驗證、回讀和恢復。</string>
    <string name="settings_geely_evcc_ambient_unavailable">目前韌體沒有通過實車驗證的可寫氛圍燈 Profile，寫入保持停用。</string>
    <string name="settings_geely_evcc_ambient_confirm_title">透過 EVCC 控制氛圍燈？</string>
    <string name="settings_geely_evcc_ambient_confirm_message">GeePlay 將儲存目前燈光、驗證每次寫入並回讀結果，播放結束時恢復原狀態；需要 EVCC property.write 授權。</string>
</resources>
