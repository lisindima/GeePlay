<resources>
    <string name="settings_geely_navigation_title">吉利原車導航（實驗性）</string>
    <string name="settings_geely_navigation_description">將 CarPlay 轉向資訊傳送到原車 ECARX 導航介面。偵測到介面不代表儀表一定能夠顯示；連線方式修改將在下次連線時生效。</string>
    <string name="settings_geely_navigation_enable">在原車儀表顯示 CarPlay 導航</string>
    <string name="settings_geely_navigation_enable_description">可能接管儀表導航畫面，修改將在下次連接 CarPlay 時生效。</string>
    <string name="settings_geely_navigation_confirm_title">啟用實驗性原車導航？</string>
    <string name="settings_geely_navigation_confirm_message">這可能覆蓋車輛自己的導航提示。請停車後測試，並確認斷開連線後導航內容能夠清除。</string>
    <string name="settings_geely_navigation_confirm_action">啟用</string>
    <string name="settings_geely_navigation_backend">平台連線方式</string>
    <string name="settings_geely_backend_auto">自動偵測</string>
    <string name="settings_geely_backend_ecarx_flyme">ECARX / Flyme Auto</string>
    <string name="settings_geely_backend_oneos">OneOS 相容模式</string>
    <string name="settings_geely_lane_guidance">車道提示（實驗性）</string>
    <string name="settings_geely_lane_guidance_description">為 ECARX 車道介面繪製 CarPlay 車道方向，需要相容的儀表；修改將在下次連線時生效。</string>
    <string name="settings_geely_lane_number_base">車道編號</string>
    <string name="settings_geely_lane_number_zero">從 0 開始</string>
    <string name="settings_geely_lane_number_one">從 1 開始</string>
    <string name="settings_geely_semantic_junction">簡化路口幾何（實驗性）</string>
    <string name="settings_geely_semantic_junction_description">只繪製 RouteGuidance 的語意支路，不是原廠路口大圖；修改將在下次連線時生效。</string>
    <string name="settings_geely_oneos_original_icons">使用 OneOS 原始轉向編號（實驗性）</string>
    <string name="settings_geely_oneos_original_icons_description">不做 ECARX 映射，直接傳遞 Apple 轉向編號。僅在目標韌體需要時啟用。</string>
    <string name="settings_geely_audio_title">吉利音訊控制方</string>
    <string name="settings_geely_audio_description">選擇音樂播放方。原車藍牙模式由車輛播放音樂並處理媒體鍵，GeePlay 仍播放導航、Siri 和通話音訊；修改將在下次連線時生效。</string>
    <string name="settings_geely_media_owner">音樂輸出</string>
    <string name="settings_geely_media_owner_bluetooth">原車藍牙</string>
    <string name="settings_geely_media_owner_diplay">GeePlay</string>
    <string name="settings_geely_input_title">吉利方向盤輸入（實驗性）</string>
    <string name="settings_geely_input_description">OneOS 媒體鍵和 Flyme 語音廣播只在 CarPlay 工作階段啟用；原車藍牙模式不攔截媒體鍵；輸入方式修改立即生效。</string>
    <string name="settings_geely_input_profile">輸入平台</string>
    <string name="settings_geely_input_disabled">關閉</string>
    <string name="settings_geely_input_oneos">OneOS 媒體鍵</string>
    <string name="settings_geely_input_flyme">Flyme 語音鍵</string>
    <string name="settings_geely_flyme_confirm_title">啟用 Flyme 語音廣播？</string>
    <string name="settings_geely_flyme_confirm_message">該原車廣播沒有已驗證的傳送者權限，本機其他應用可能偽造事件，原車語音助理也可能同時回應。</string>
    <string name="settings_geely_flyme_confirm_action">仍然啟用</string>
