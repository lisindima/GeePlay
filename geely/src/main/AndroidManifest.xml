<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.geely.service.oneosapi" />
        <package android:name="com.kooo.evcc" />
    </queries>

    <uses-permission android:name="com.permission.adnaviservice" />
    <uses-permission android:name="com.kooo.evcc.permission.ACCESS_EVCC_API" />

    <application
        android:name=".GeePlayApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_geeplay_car_home"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_geeplay_car_home"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xcertplay"
        tools:replace="android:label">
        <!-- GeePlay does not expose DiPlay's launcher-facing map embedding service. -->
        <service android:name="com.shilapi.xcertplay.MapEmbedService" tools:node="remove" />
        <receiver
            android:name="com.shilapi.xcertplay.PhoneBluetoothReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <service android:name="com.shilapi.xcertplay.shared.MyCarAppService" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />
    </application>

</manifest>
